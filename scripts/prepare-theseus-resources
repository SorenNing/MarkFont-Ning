#!/usr/bin/env bash
# Theseus's SwiftPM resource contract, without invoking SwiftPM or modifying vendor.
set -euo pipefail

fail() { printf 'Theseus resources: %s\n' "$*" >&2; exit 1; }

case "${1:-}" in
  shim)
    [[ $# == 2 ]] || fail 'usage: prepare-theseus-resources shim OUTPUT.swift'
    output=$2
    mkdir -p "$(dirname "$output")"
    temporary=$(mktemp "${output}.XXXXXX")
    trap 'rm -f "$temporary"' EXIT
    cat > "$temporary" <<'SWIFT'
// Generated by prepare-theseus-resources. Compiled into the FontManager module.
import Foundation

extension Bundle {
    static let module: Bundle = {
        guard let url = Bundle.main.url(forResource: "Theseus_Theseus", withExtension: "bundle"),
              let bundle = Bundle(url: url) else {
            fatalError("Missing Theseus_Theseus.bundle in FontManager.app")
        }
        return bundle
    }()
}
SWIFT
    if [[ ! -f "$output" ]] || ! cmp -s "$temporary" "$output"; then
      mv -f "$temporary" "$output"
    fi
    ;;
  metal)
    [[ $# == 5 ]] || fail 'usage: prepare-theseus-resources metal SHADER_DIR OUTPUT.bundle SDKROOT IOS_MIN'
    shader_dir=$2
    output=$3
    sdk=$4
    minimum=$5
    [[ -d "$shader_dir" ]] || fail "missing shader directory: $shader_dir"
    [[ -d "$sdk" ]] || fail "missing iPhoneOS SDK: $sdk"
    [[ "$minimum" =~ ^[0-9]+(\.[0-9]+){0,2}$ ]] || fail "invalid iOS deployment target: $minimum"
    command -v xcrun >/dev/null || fail 'Metal compilation requires macOS with Xcode'
    xcrun --sdk iphoneos --find metal >/dev/null 2>&1 || fail 'Metal toolchain unavailable; run xcodebuild -downloadComponent MetalToolchain'
    mkdir -p "$(dirname "$output")"
    temporary=$(mktemp -d "${output}.XXXXXX")
    trap 'rm -rf "$temporary"' EXIT
    mkdir -p "$temporary/bundle" "$temporary/air"
    air_files=()
    # Null-delimited traversal also handles shader filenames containing spaces.
    find "$shader_dir" -type f -name '*.metal' -print0 > "$temporary/shaders.list"
    while IFS= read -r -d '' shader; do
      air="$temporary/air/${#air_files[@]}.air"
      xcrun --sdk iphoneos metal -c "$shader" -isysroot "$sdk" \
        -mios-version-min="$minimum" -std=ios-metal2.3 -I "$shader_dir" -o "$air"
      air_files+=("$air")
    done < "$temporary/shaders.list"
    [[ ${#air_files[@]} -gt 0 ]] || fail 'no .metal files found'
    xcrun --sdk iphoneos metallib "${air_files[@]}" -o "$temporary/bundle/default.metallib"
    [[ -s "$temporary/bundle/default.metallib" ]] || fail 'metallib is empty'
    # The upstream package only processes Shaders; preserve any future data files
    # and localization directories, while excluding GPU source/header inputs.
    find "$shader_dir" -type f -print0 > "$temporary/resources.list"
    while IFS= read -r -d '' resource; do
      relative=${resource#"$shader_dir"/}
      case "$relative" in *.metal|*.h|*.hpp|*.air|*.metallib) continue ;; esac
      mkdir -p "$temporary/bundle/$(dirname "$relative")"
      cp "$resource" "$temporary/bundle/$relative"
    done < "$temporary/resources.list"
    cat > "$temporary/bundle/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>com.hmmzzz.fontmanager.theseus-resources</string>
<key>CFBundleName</key><string>Theseus_Theseus</string>
<key>CFBundlePackageType</key><string>BNDL</string>
<key>CFBundleVersion</key><string>1</string>
</dict></plist>
PLIST
    mkdir -p "$output"
    # Replace the complete resource contents to avoid stale shaders after updates.
    find "$output" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
    cp -R "$temporary/bundle/." "$output/"
    ;;
  *) fail 'expected shim or metal subcommand' ;;
esac
